@media (min-width: 750px) {
  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-single__title {
    margin-bottom: 0;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product__price {
    margin-bottom: 0;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--header {
    margin-bottom: 14px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--price {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block:has(.product-trust-line) {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--sales-point {
    margin-top: 0;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--sales-point:has(.icon--inventory) {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--sales-point .sales-points {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block--sales-point .icon-and-text {
    padding: 6px 12px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-single__form {
    margin-top: 0;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-single__form .payment-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block:has(.product-single__form) {
    margin-bottom: 9px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-single__form .shopify-payment-button {
    opacity: 0.9;
    margin: 0;
    --shopify-accelerated-checkout-button-block-size: 48px;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-single__form .shopify-payment-button__button {
    min-height: 48px;
    filter: saturate(0.9) brightness(0.98);
    box-shadow: none;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-shipping-note {
    margin: 0;
  }

  #shopify-section-{{ section_id }} .sb-acrylics-pdp-scope .product-block:has(.product-shipping-note) {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-product-recommendations product-recommendations {
    margin-top: 12px;
    padding-top: 10px;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-product-recommendations product-recommendations::after {
    height: calc(18px + env(safe-area-inset-bottom, 0px));
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-product-recommendations .index-section {
    margin: 12px 0;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-product-recommendations .section-header {
    margin-bottom: 8px;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-recently-viewed .hr--large {
    margin: 8px 0;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-recently-viewed .index-section--small {
    margin: 10px 0;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-recently-viewed .section-header {
    margin-bottom: 8px;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-collection-return .page-content--bottom {
    padding-top: 12px;
    padding-bottom: 12px;
  }

  #shopify-section-{{ section_id }}:has(.sb-acrylics-pdp-scope) ~ #shopify-section-collection-return .return-link {
    background: transparent;
    border: 1px solid rgba(11, 18, 32, 0.2);
    color: #0b1220;
    box-shadow: none;
    min-height: 44px;
    padding: 8px 16px;
  }
}
