{%- if linklists[block.settings.menu].links.size > 0 -%}
  {%- assign menu_title = linklists[block.settings.menu].title | default: 'Help' -%}
  <div class="footer__menu-block{% unless block.settings.show_footer_title %} footer__menu-block--no-title{% endunless %}">
    {%- if block.settings.show_footer_title -%}
      <h2 class="h4 footer__title small--hide">
        {{ menu_title }}
      </h2>
    {%- else -%}
      <h2 class="h4 footer__title footer__title--inferred small--hide">
        {{ menu_title }}
      </h2>
    {%- endif -%}
    <button type="button" class="h4 footer__title footer__accordion-trigger collapsible-trigger collapsible-trigger-btn medium-up--hide" aria-controls="Footer-{{ block.id }}">
      <span class="footer__accordion-label">{{ menu_title }}</span>
      {%- render 'collapsible-icons' -%}
    </button>
    <div id="Footer-{{ block.id }}" class="collapsible-content collapsible-content--small footer__accordion-content">
      <div class="collapsible-content__inner">
        <div class="footer__collapsible footer__accordion-body">
          <ul class="no-bullets site-footer__linklist">
            {%- for link in linklists[block.settings.menu].links -%}
              {%- assign link_handle = link.title | handle -%}
              <li>
                <a href="{{ link.url }}"{% if link_handle == 'join-the-list' %} class="footer__cta-link"{% endif %}>{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
