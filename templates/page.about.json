        "text_about": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Stonebrook Collectibles is a <strong>sealed-first</strong> shop focused on trust, careful packing, and fast support. Everything we sell is <strong>100% authentic and factory sealed</strong>. Whether you're grabbing a single box or placing a bulk order, you'll get consistent communication and secure packaging every time.</p><p>When it fits your order, we can also bundle acrylic display cases at our cost to help protect your sealed product. Acrylic cases are limited and subject to availability.</p>"
          }
