{%- liquid
  assign has_stats = false
  if section.settings.stat_1 != blank or section.settings.stat_2 != blank or section.settings.stat_3 != blank
    assign has_stats = true
  endif
-%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }}.index-section {
    background: transparent;
  }

  @media (min-width: 990px) {
    #shopify-section-{{ section.id }}.index-section {
      position: relative;
      padding-top: clamp(24px, 2.4vw, 40px);
      padding-bottom: clamp(24px, 2.4vw, 40px);
      margin: 0;
    }

    #shopify-section-{{ section.id }}.index-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: min(880px, 80%);
      height: 1px;
      background: linear-gradient(90deg, rgba(212, 175, 55, 0), rgba(212, 175, 55, 0.5), rgba(212, 175, 55, 0));
      pointer-events: none;
    }
  }

  #shopify-section-{{ section.id }} .page-width {
    max-width: 1440px;
  }

  .template-index #shopify-section-{{ section.id }} .page-width {
    max-width: 1100px;
  }

  #shopify-section-{{ section.id }} .sb-proof {
    width: 100%;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sb-proof__card {
    border-radius: 22px;
    padding: clamp(22px, 2.6vw, 40px);
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(148, 163, 184, 0.35);
    box-shadow: 0 16px 30px rgba(11, 18, 32, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.85);
    color: #0b1220;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sb-proof__card::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sb-proof__layout {
    display: grid;
    gap: clamp(16px, 2.4vw, 28px);
    align-items: start;
  }

  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .sb-proof {
      padding-top: clamp(12px, 1.4vw, 24px);
      padding-bottom: clamp(32px, 3.2vw, 56px);
    }

    #shopify-section-{{ section.id }} .sb-proof__layout {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (min-width: 750px) {
    .template-index #shopify-section-{{ section.id }}.index-section {
      padding-top: clamp(14px, 1.6vw, 20px);
      padding-bottom: clamp(12px, 1.6vw, 18px);
    }

    .template-index #shopify-section-{{ section.id }} .sb-proof {
      padding-top: clamp(6px, 1vw, 12px);
      padding-bottom: clamp(12px, 1.6vw, 20px);
    }

    .template-index #shopify-section-{{ section.id }} .sb-proof__card {
      padding: clamp(20px, 2.2vw, 34px);
    }

    .template-index #shopify-section-{{ section.id }} .sb-proof__layout {
      gap: clamp(14px, 1.8vw, 22px);
    }
  }

  #shopify-section-{{ section.id }} .sb-proof__subtitle {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .sb-proof__title {
    margin: 0 0 12px;
    font-weight: 700;
    font-size: clamp(1.35rem, 1.6vw, 1.85rem);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sb-proof__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 12px 0 16px;
  }

  #shopify-section-{{ section.id }} .sb-proof__chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: rgba(212, 175, 55, 0.16);
    border: 1px solid rgba(212, 175, 55, 0.35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    color: #0b1220;
  }

  #shopify-section-{{ section.id }} .sb-proof__content {
    max-width: 860px;
  }

  #shopify-section-{{ section.id }} .sb-proof__rte {
    margin: 0;
    font-size: 1rem;
  }

  #shopify-section-{{ section.id }} .sb-proof__rte ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sb-proof__rte li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0;
    font-size: 1rem;
  }

  #shopify-section-{{ section.id }} .sb-proof__rte li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sb-gold);
    margin-top: 0.6em;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .sb-proof__cta {
    align-self: start;
  }

  #shopify-section-{{ section.id }} .sb-proof--primary-btn .sb-proof__cta .btn {
    position: relative;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0) 65%), var(--sb-gold);
    color: var(--sb-ink);
    border-color: var(--sb-gold);
    border-radius: 14px;
    box-shadow: 0 12px 26px rgba(11, 18, 32, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sb-proof--primary-btn .sb-proof__cta .btn::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sb-proof--primary-btn .sb-proof__cta .btn:hover {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 65%), var(--sb-gold-hover);
    border-color: var(--sb-gold-hover);
    color: var(--sb-ink);
    box-shadow: 0 14px 30px rgba(11, 18, 32, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  #shopify-section-{{ section.id }} .sb-proof--primary-btn .sb-proof__cta .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.32), 0 12px 26px rgba(11, 18, 32, 0.18);
  }

  #shopify-section-{{ section.id }} .sb-proof__cta .btn::after {
    content: '\2192';
    margin-left: 8px;
    font-weight: 700;
  }

  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .sb-proof__cta {
      align-self: start;
      justify-self: end;
      text-align: right;
    }

    #shopify-section-{{ section.id }} .sb-proof__cta .btn {
      min-width: 240px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sb-proof__card {
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .sb-proof__layout {
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .sb-proof__cta {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .sb-proof__cta .btn {
      width: 100%;
    }
  }

  #shopify-section-{{ section.id }} .text-center .sb-proof__stats {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .text-right .sb-proof__stats {
    justify-content: flex-end;
  }

  {% if section.settings.top_padding == false %}
    #shopify-section-{{ section.id }}.index-section {
      padding-top: 0 !important;
      margin-top: 0 !important;
    }
  {% endif %}

  {% if section.settings.bottom_padding == false %}
    #shopify-section-{{ section.id }}.index-section {
      padding-bottom: 0 !important;
      margin-bottom: 0 !important;
    }
  {% endif %}
{% endstyle %}

<div class="sb-proof{% if section.settings.button_style == 'primary' %} sb-proof--primary-btn{% endif %}">
  <div class="page-width">
    <div class="sb-proof__card">
      <div class="sb-proof__layout text-{{ section.settings.align_text }}">
        <div class="sb-proof__content">
          {%- if section.settings.subtitle != blank -%}
            <div class="sb-proof__subtitle">{{ section.settings.subtitle | escape }}</div>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="sb-proof__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if has_stats -%}
            <div class="sb-proof__stats">
              {%- if section.settings.stat_1 != blank -%}
                <span class="sb-proof__chip">{{ section.settings.stat_1 | escape }}</span>
              {%- endif -%}
              {%- if section.settings.stat_2 != blank -%}
                <span class="sb-proof__chip">{{ section.settings.stat_2 | escape }}</span>
              {%- endif -%}
              {%- if section.settings.stat_3 != blank -%}
                <span class="sb-proof__chip">{{ section.settings.stat_3 | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="sb-proof__rte rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div class="sb-proof__cta">
            <a href="{{ section.settings.button_link }}" class="btn{% if section.settings.button_style == 'secondary' %} btn--tertiary{% endif %}">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "Trusted Seller Proof",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted Seller"
    },
    {
      "type": "text",
      "id": "stat_1",
      "label": "Stat chip 1",
      "default": "500+ orders"
    },
    {
      "type": "text",
      "id": "stat_2",
      "label": "Stat chip 2",
      "default": "100% positive"
    },
    {
      "type": "text",
      "id": "stat_3",
      "label": "Stat chip 3",
      "default": "Maryland"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<ul><li>100% positive feedback</li><li>Fast handling from Maryland</li><li>Factory sealed only (no reseals)</li></ul>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_padding",
      "label": "Top padding",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bottom_padding",
      "label": "Bottom padding",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Trusted Seller Proof"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
