{%- liquid
  assign image_width = section.settings.image_width
  assign overlap_images = true
  if section.settings.image == blank or section.settings.image2 == blank
    assign overlap_images = false
  endif

  if section.settings.image == blank and section.settings.image2 == blank
    assign overlap_images = true
    assign placeholder_images = true
  endif

  assign is_trusted_seller = true
  assign trusted_seller_no_image = false
  if section.settings.image == blank and section.settings.image2 == blank
    assign trusted_seller_no_image = true
  endif
  assign is_index = false
  if template.name == 'index'
    assign is_index = true
  endif
  assign use_divider = false
  if section.settings.divider
    if is_trusted_seller and trusted_seller_no_image and is_index
      assign use_divider = false
    else
      assign use_divider = true
    endif
  endif
-%}
{%- comment -%}
  Skip section--divider for Trusted Seller proof-only on homepage: divider adds padding-top 75px (desktop)
  and would increase gap above; we use top_padding toggle + gap overrides instead.
{%- endcomment -%}
{%- if use_divider -%}<div class="section--divider">{%- endif -%}

{% style %}
  {% comment %} Show top/bottom padding toggles: control both margin AND padding. Theme applies padding via .index-section; we override when off. {% endcomment %}
  {% if section.settings.top_padding == false %}
    #shopify-section-{{ section.id }} .index-section {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
  {% endif %}
  {% if section.settings.bottom_padding == false %}
    #shopify-section-{{ section.id }} .index-section {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }
  {% endif %}
  {% if is_trusted_seller and trusted_seller_no_image and is_index %}
    /* Desktop (>=750px): Trusted Seller on navy — white text for contrast. */
    @media only screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .sb-trusted-seller__content h2,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte ul,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte li,
      #shopify-section-{{ section.id }} .sb-trusted-seller__chip {
        color: rgba(255, 255, 255, 0.95) !important;
      }
    }
    /* Mobile (<=749px): Trusted Seller in light box — dark text for contrast. */
    @media only screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .sb-trusted-seller__content h2,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte ul,
      #shopify-section-{{ section.id }} .sb-trusted-seller__content .rte li {
        color: #0b1220 !important;
      }
      #shopify-section-{{ section.id }} .sb-trusted-seller__chip {
        color: #0b1220 !important;
      }
    }
    /* Reduce gap below Trusted Seller (including below CTA/button) before Why Stonebrook. DESKTOP ONLY. */
    @media only screen and (min-width: 750px) {
      .template-index #shopify-section-{{ section.id }},
      .template-index #shopify-section-{{ section.id }} .index-section {
        margin-bottom: 0 !important;
        padding-bottom: 96px !important;
        padding-top: 0 !important;
      }
    }
  {% endif %}
{% endstyle %}

<div class="index-section sb-trusted-seller{% if trusted_seller_no_image %} sb-trusted-seller--proof-only{% endif %}">

  <div class="page-width feature-row-wrapper feature-row--{% if trusted_seller_no_image %}100{% else %}{{ image_width }}{% endif %}">
    {%- unless trusted_seller_no_image -%}
    {%- capture image_layout -%}
      <div class="feature-row__item feature-row__images{% if overlap_images %} feature-row__item--overlap-images{% endif %} {% if placeholder_images %}feature-row__item--placeholder-images{% endif %}" data-aos>
          {%- if section.settings.image != blank -%}
            <div class="feature-row__first-image">
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}<a href="{{ section.settings.button_link }}">{%- endif -%}
                <div class="image-wrap {% if section.settings.image_mask != 'none' %}svg-mask svg-mask--{{ section.settings.image_mask }}{% endif %}" style="height: 0; padding-bottom: {{ 100 | divided_by: section.settings.image.aspect_ratio }}%;">
                  {%- liquid
                    if section.settings.image2 == blank
                      assign sizeVariable = section.settings.image_width | append: 'vw'
                      assign fallback = '100vw'
                    else
                      assign sizeVariable = 'calc(0.4 * 50vw)'
                      assign fallback = '40vw'
                    endif

                    assign imageWidth = section.settings.image_width | times: 1
                    if imageWidth >= 50
                      assign loading = section.settings.lazyload_images
                    else
                      assign loading = true
                    endif
                  -%}
                  {%- render 'image-element',
                    img: section.settings.image,
                    widths: '180, 360, 540, 750, 900, 1080',
                    loading: loading,
                    sizeVariable: sizeVariable,
                    fallback: fallback,
                    classes: 'feature-row__image',
                  -%}
                </div>
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}</a>{%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.image2 != blank -%}
            <div class="feature-row__second-image">
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}<a href="{{ section.settings.button_link }}">{%- endif -%}
                <div class="image-wrap {% if section.settings.image2_mask != 'none' %}svg-mask svg-mask--{{ section.settings.image2_mask }}{% endif %}" style="height: 0; padding-bottom: {{ 100 | divided_by: section.settings.image2.aspect_ratio }}%;">
                  {%- liquid
                    if section.settings.image == blank
                      assign sizeVariable = section.settings.image_width | append: 'vw'
                      assign fallback = '100vw'
                    else
                      assign sizeVariable = 'calc(0.6 * 50vw)'
                      assign fallback = '60vw'
                    endif
                  -%}
                  {%- render 'image-element',
                    img: section.settings.image2,
                    widths: '180, 360, 540, 750, 900, 1080',
                    sizeVariable: sizeVariable,
                    fallback: fallback,
                    classes: 'feature-row__image',
                  -%}
                </div>
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}</a>{%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.image == blank and section.settings.image2 == blank -%}
            <div class="placeholder-image-wrap">
              <div class="image-wrap">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
            <div class="placeholder-image-wrap">
              <div class="image-wrap">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- endunless -%}

    <div class="feature-row{% if trusted_seller_no_image %} feature-row--text-only{% endif %}">
      {%- unless trusted_seller_no_image -%}
        {%- if section.settings.layout == 'left' -%}
          {{ image_layout }}
        {%- endif -%}
      {%- endunless -%}

      <div class="feature-row__item feature-row__text feature-row__text--{% if trusted_seller_no_image %}full{% else %}{{ section.settings.layout }}{% endif %} text-{{ section.settings.align_text }}{% if trusted_seller_no_image %} sb-trusted-seller__row{% endif %}" data-aos>
        {%- if section.settings.subtitle != blank -%}
          <div class="subheading appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if trusted_seller_no_image -%}
          <div class="sb-trusted-seller__content">
            {%- if section.settings.title != blank -%}
              <h2 class="h1">{{ section.settings.title | escape }}</h2>
            {%- endif -%}
            <div class="sb-trusted-seller__stats">
              <span class="sb-trusted-seller__chip">500+ orders</span>
              <span class="sb-trusted-seller__chip">100% positive</span>
              <span class="sb-trusted-seller__chip">Maryland</span>
            </div>
            {%- if section.settings.text != blank -%}
              <div class="rte">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
          {%- if section.settings.button_label != blank -%}
            <div class="sb-trusted-seller__cta">
              <a href="{{ section.settings.button_link }}" class="btn{% if section.settings.button_style == 'secondary' %} btn--tertiary{% endif %}">
                {{ section.settings.button_label }}
              </a>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if section.settings.title != blank -%}
            <h2 class="h1 appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="rte appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <div class="appear-delay{% cycle '','-1','-2','-3','-4' %}">
              <a href="{{ section.settings.button_link }}" class="btn{% if section.settings.button_style == 'secondary' %} btn--tertiary{% endif %}">
                {{ section.settings.button_label }}
              </a>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- unless trusted_seller_no_image -%}
        {%- if section.settings.layout == 'right' -%}
          {{ image_layout }}
        {%- endif -%}
      {%- endunless -%}
    </div>
  </div>

</div>

{%- if use_divider -%}</div>{%- endif -%}

