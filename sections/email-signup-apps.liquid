{%- liquid
  assign is_email_signup = false
  if template.name == 'page' and template.suffix == 'email-signup'
    assign is_email_signup = true
  endif
-%}

{%- if section.settings.space_around -%}
  <div class="index-section">
{%- endif -%}

{%- unless section.settings.full_width -%}
  <div class="page-width">
{%- endunless -%}

  <div class="sb-email-signup-band"{% if is_email_signup %} data-sb-email-signup data-sb-template="email-signup"{% endif %}>
    <div class="sb-email-signup-card">
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}

{%- if section.settings.space_around -%}
  </div>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: #0b1220;
    background-image:
      radial-gradient(160% 160% at 50% 8%, rgba(27, 38, 60, 0.6) 0%, rgba(11, 18, 32, 0.98) 62%, rgba(10, 16, 30, 1) 100%),
      linear-gradient(180deg, rgba(18, 28, 46, 0.35) 0%, rgba(10, 16, 30, 0.95) 100%);
    background-repeat: no-repeat;
    background-position: center top;
    padding: clamp(32px, 5vw, 64px) 0;
  }

  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: -20% -10% -20% -10%;
    background: radial-gradient(520px 520px at 20% 24%, rgba(214, 178, 94, 0.1), rgba(11, 18, 32, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }}::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 80px;
    background: linear-gradient(180deg, rgba(11, 18, 32, 0) 0%, #0b1220 100%);
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .index-section {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sb-email-signup-band {
    display: flex;
    justify-content: center;
    position: relative;
    width: 100%;
    z-index: 1;
    padding: 0 clamp(14px, 4vw, 24px);
  }

  #shopify-section-{{ section.id }} .sb-email-signup-card {
    --sb-card-bg: #ffffff;
    --sb-card-border: #e6eaf2;
    --sb-card-shadow: var(--sb-shadow-soft);
    background: var(--sb-card-bg);
    border: 1px solid var(--sb-card-border);
    border-radius: 26px;
    box-shadow: var(--sb-card-shadow);
    color: var(--sb-ink);
    margin: 0 auto;
    max-width: 820px;
    padding: clamp(28px, 4vw, 52px);
    text-align: center;
    width: 100%;
    position: relative;
    z-index: 1;
    scroll-margin-top: clamp(90px, 14vh, 140px);
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK {
    margin: 0 auto;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK select,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK textarea,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
    max-width: 520px;
    width: 100% !important;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
    min-height: 54px;
    border-radius: 999px !important;
    background: var(--sb-gold) !important;
    color: #0b1220 !important;
    border: 1px solid rgba(212, 175, 55, 0.9) !important;
    box-shadow: 0 12px 26px rgba(11, 18, 32, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK p,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK small,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK label {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: 28px;
      padding-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .sb-email-signup-card {
      padding: 24px 20px 28px;
      border-radius: 22px;
      max-width: 560px;
    }

    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK select,
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK textarea,
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
      max-width: 100%;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK form {
      background-color: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 20px 18px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-component'] {
      padding-left: 4px !important;
      padding-right: 4px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:first-of-type [data-testid='form-component'] {
      padding-top: 6px !important;
      padding-bottom: 6px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(2) [data-testid='form-component'] {
      padding-top: 8px !important;
      padding-bottom: 10px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(3) [data-testid='form-component'],
    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(4) [data-testid='form-component'] {
      padding-top: 6px !important;
      padding-bottom: 6px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(5) [data-testid='form-component'] {
      padding-top: 6px !important;
      padding-bottom: 10px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child [data-testid='form-component'] {
      padding-top: 6px !important;
      padding-bottom: 6px !important;
      justify-content: center !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK p {
      font-size: 14px !important;
      line-height: 1.5 !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:first-of-type span {
      display: inline-block;
      font-size: 28px !important;
      line-height: 1.12 !important;
      max-width: 19ch;
      margin: 0 auto;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(2) p {
      font-size: 16px !important;
      line-height: 1.35 !important;
      margin: 0 0 6px;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(2) p:last-child {
      font-size: 14px !important;
      line-height: 1.45 !important;
      margin: 0 auto;
      max-width: 34ch;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK input[type='email'] {
      background-color: #fff !important;
      border-color: #cfd7e5 !important;
      border-radius: 14px !important;
      font-family: 'Funnel Sans', Helvetica, Arial, sans-serif !important;
      font-size: 16px !important;
      height: 52px !important;
      line-height: 1.2 !important;
      min-height: 52px !important;
      padding: 0 16px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK input[type='email']::placeholder {
      font-family: 'Funnel Sans', Helvetica, Arial, sans-serif !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK button {
      font-size: 16px !important;
      height: 52px !important;
      letter-spacing: 0.6px !important;
      line-height: 1 !important;
      min-height: 52px !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(4) button {
      white-space: nowrap !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:nth-of-type(5) p {
      font-size: 13px !important;
      line-height: 1.5 !important;
      margin: 0 !important;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    body[data-sb-email-signup-page] [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child button {
      background: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      color: #667085 !important;
      font-size: 14px !important;
      height: auto !important;
      letter-spacing: 0 !important;
      min-height: 44px !important;
      padding: 10px 14px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      width: auto !important;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__title {
      text-align: center;
      margin: 0 auto 18px;
      padding-top: 8px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__title h2 {
      text-align: center;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__blocks {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      margin: 0;
      padding: 0;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block {
      background: #fff;
      border: 1px solid rgba(148, 163, 184, 0.35);
      border-radius: 20px;
      box-shadow: 0 10px 22px rgba(11, 18, 32, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.7);
      padding: 22px 18px;
      text-align: center;
      margin: 0;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-icon svg {
      width: 36px;
      height: 36px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-title h3 {
      color: #0b1220;
      margin: 0 0 8px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-text,
    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-text p,
    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-text li {
      color: #3c4657;
      margin: 0;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__block-text p + p {
      margin-top: 6px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__button {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__button .sb-btn-primary {
      position: relative;
      overflow: hidden;
      border-radius: 999px;
      border: 1px solid rgba(184, 140, 31, 0.9);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0) 65%), var(--sb-gold);
      box-shadow: 0 12px 26px rgba(11, 18, 32, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.5);
      padding: 12px 26px;
    }

    body[data-sb-email-signup-page] .sb-why-stonebrook .text-with-icons__button .sb-btn-primary::before {
      content: '';
      position: absolute;
      inset: 1px;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
      pointer-events: none;
    }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      background-image:
        radial-gradient(180% 170% at 50% 6%, rgba(31, 44, 68, 0.65) 0%, rgba(11, 18, 32, 0.97) 60%, rgba(9, 14, 26, 1) 100%),
        linear-gradient(180deg, rgba(18, 28, 46, 0.5) 0%, rgba(10, 16, 30, 0.96) 100%);
    }

    #shopify-section-{{ section.id }}::before {
      background: radial-gradient(560px 560px at 18% 22%, rgba(214, 178, 94, 0.14), rgba(11, 18, 32, 0) 72%);
    }

    #shopify-section-{{ section.id }} .sb-email-signup-card {
      margin-bottom: var(--sb-section-gap-d, 32px);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Email signup apps",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.apps.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "space_around",
      "label": "t:sections.apps.settings.space_around.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Email signup apps"
    }
  ]
}
{% endschema %}
