{%- liquid
  assign is_email_signup = false
  if template.name == 'page' and template.suffix == 'email-signup'
    assign is_email_signup = true
  endif
-%}

{%- if section.settings.space_around -%}
  <div class="index-section">
{%- endif -%}

{%- unless section.settings.full_width -%}
  <div class="page-width">
{%- endunless -%}

  <div class="sb-email-signup-band"{% if is_email_signup %} data-sb-email-signup data-sb-template="email-signup"{% endif %}>
    <div class="sb-email-signup-card">
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}

{%- if section.settings.space_around -%}
  </div>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: #0b1220;
    background-image:
      radial-gradient(160% 160% at 50% 8%, rgba(27, 38, 60, 0.6) 0%, rgba(11, 18, 32, 0.98) 62%, rgba(10, 16, 30, 1) 100%),
      linear-gradient(180deg, rgba(18, 28, 46, 0.35) 0%, rgba(10, 16, 30, 0.95) 100%);
    background-repeat: no-repeat;
    background-position: center top;
    padding: clamp(32px, 5vw, 64px) 0;
  }

  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: -20% -10% -20% -10%;
    background: radial-gradient(520px 520px at 20% 24%, rgba(214, 178, 94, 0.1), rgba(11, 18, 32, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }}::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 80px;
    background: linear-gradient(180deg, rgba(11, 18, 32, 0) 0%, #0b1220 100%);
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .index-section {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sb-email-signup-band {
    display: flex;
    justify-content: center;
    position: relative;
    width: 100%;
    z-index: 1;
    padding: 0 clamp(14px, 4vw, 24px);
  }

  #shopify-section-{{ section.id }} .sb-email-signup-card {
    --sb-card-bg: #ffffff;
    --sb-card-border: #e6eaf2;
    --sb-card-shadow: var(--sb-shadow-soft);
    background: var(--sb-card-bg);
    border: 1px solid var(--sb-card-border);
    border-radius: 26px;
    box-shadow: var(--sb-card-shadow);
    color: var(--sb-ink);
    margin: 0 auto;
    max-width: 820px;
    padding: clamp(28px, 4vw, 52px);
    text-align: center;
    width: 100%;
    position: relative;
    z-index: 1;
    scroll-margin-top: clamp(90px, 14vh, 140px);
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK {
    margin: 0 auto;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK select,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK textarea,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
    max-width: 520px;
    width: 100% !important;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
    min-height: 54px;
    border-radius: 999px !important;
    background: var(--sb-gold) !important;
    color: #0b1220 !important;
    border: 1px solid rgba(212, 175, 55, 0.9) !important;
    box-shadow: 0 12px 26px rgba(11, 18, 32, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
  }

  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child button,
  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child a,
  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child [role='button'],
  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child input[type='submit'],
  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK [data-testid='form-row']:last-child input[type='button'],
  body[data-sb-email-signup-page] #shopify-section-{{ section.id }} [data-sb-email-signup] .klaviyo-form-SvVPFK .sb-email-signup-secondary-cta {
    background: rgba(11, 18, 32, 0.04) !important;
    border: 1px solid rgba(11, 18, 32, 0.18) !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    color: #0b1220 !important;
    font-size: 16px !important;
    min-height: 52px !important;
    height: 52px !important;
    letter-spacing: 0.01em !important;
    width: 100% !important;
    margin-top: 8px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
    text-align: center !important;
    white-space: nowrap !important;
    -webkit-appearance: none !important;
  }

  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK p,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK small,
  #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK label {
