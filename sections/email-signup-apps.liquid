      box-shadow: none !important;
      color: inherit !important;
      min-height: 44px !important;
      padding: 8px 12px !important;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, div):has(a[href*="privacy"]) + * :is(a, button):hover,
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, div):has(a[href*="privacy"]) + * :is(a, button):focus-visible {
