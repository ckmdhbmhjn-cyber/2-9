    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK form > div[style*="padding"],
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK [data-testid="form-row"],
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK [data-testid^="form-row"] {
      padding: 8px 6px !important;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(h1, h2, h3) {
      font-size: 29px !important;
