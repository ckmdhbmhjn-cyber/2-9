      font-size: 16.5px !important;
      line-height: 1.35 !important;
      max-width: 32ch;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, span, div)[style*="font-size: 16"],
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, span, div)[style*="font-size:16"] {
      font-size: 14.5px !important;
      line-height: 1.4 !important;
      max-width: 34ch;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, span, div, small)[style*="font-size: 12"],
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, span, div, small)[style*="font-size:12"],
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK small {
      font-size: 13.5px !important;
      line-height: 1.5 !important;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, div):has(a[href*="privacy"]) {
      margin-top: 10px !important;
      max-width: 34ch;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(p, small, label) {
      margin-top: 0;
      margin-bottom: 6px;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK a[href*="privacy"] {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    #shopify-section-{{ section.id }}:has([data-sb-email-signup][data-sb-template="email-signup"]) {
      padding-bottom: 22px;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK form {
