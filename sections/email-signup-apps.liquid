    }

    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK select,
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK textarea,
    #shopify-section-{{ section.id }} .klaviyo-form-SvVPFK button {
      max-width: 100% !important;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK input:not([type='hidden']):not([type='checkbox']):not([type='radio']),
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK select,
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK textarea {
      font-family: var(--typeBasePrimary), var(--typeBaseFallback) !important;
      font-size: 16px !important;
      height: 54px !important;
      line-height: 1.2 !important;
      border-radius: 16px !important;
      border-color: rgba(11, 18, 32, 0.25) !important;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK input::placeholder {
