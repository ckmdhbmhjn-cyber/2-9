    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK button:not([type]) {
      height: 54px !important;
      min-height: 54px !important;
      font-size: 16.5px !important;
      letter-spacing: 0.6px !important;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(button[type="button"], button[type="reset"], a[role="button"]) {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      color: inherit !important;
      min-height: 44px !important;
      padding: 8px 12px !important;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(button[type="button"], button[type="reset"], a[role="button"]):hover,
    #shopify-section-{{ section.id }} [data-sb-email-signup][data-sb-template="email-signup"] .klaviyo-form-SvVPFK :is(button[type="button"], button[type="reset"], a[role="button"]):focus-visible {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      background-image:
        radial-gradient(180% 170% at 50% 6%, rgba(31, 44, 68, 0.65) 0%, rgba(11, 18, 32, 0.97) 60%, rgba(9, 14, 26, 1) 100%),
        linear-gradient(180deg, rgba(18, 28, 46, 0.5) 0%, rgba(10, 16, 30, 0.96) 100%);
