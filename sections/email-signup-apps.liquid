<script>
  (function () {
    var isEmailSignupPage = document.body && document.body.hasAttribute('data-sb-email-signup-page');
    if (!isEmailSignupPage) {
      return;
    }

    var applySecondaryClass = function () {
      var root = document.querySelector('[data-sb-email-signup] .klaviyo-form-SvVPFK');
      if (!root) {
        return;
      }

      var ctas = root.querySelectorAll("button, a, [role='button'], input[type='submit'], input[type='button']");
      ctas.forEach(function (cta) {
        var label = (cta.textContent || cta.value || cta.getAttribute('aria-label') || '').trim().toLowerCase();
        label = label.replace(/\s+/g, ' ');
        if (label.indexOf('continue shopping') !== -1) {
          cta.classList.add('sb-email-signup-secondary-cta');
        }
      });
    };

    applySecondaryClass();
    document.addEventListener('DOMContentLoaded', applySecondaryClass);
    window.addEventListener('load', applySecondaryClass);
    window.setTimeout(applySecondaryClass, 600);
    window.setTimeout(applySecondaryClass, 1800);
    window.setTimeout(applySecondaryClass, 4000);

    var observer = new MutationObserver(applySecondaryClass);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    window.setTimeout(function () {
      observer.disconnect();
    }, 30000);
  })();
</script>

