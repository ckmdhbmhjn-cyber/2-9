{%- liquid
  assign is_modal = false
  if template == 'product.modal'
    assign is_modal = true
  endif

  assign sb_section_class = section.settings.section_class | default: ''
  if template == 'product.product-sealed-pokemon'
    assign sb_section_class = sb_section_class | append: ' sb-sealed-pdp-scope'
  elsif template == 'product.product-acrylics'
    assign sb_section_class = sb_section_class | append: ' sb-acrylics-pdp-scope'
  endif
-%}

{%- render 'product-template',
  product: product,
  section_id: section.id,
  blocks: section.blocks,
  image_position: section.settings.image_position,
  image_container_width: section.settings.image_size,
  product_zoom_enable: section.settings.product_zoom_enable,
  sku_enable: section.settings.sku_enable,
  isModal: is_modal,
  thumbnail_position: section.settings.thumbnail_position,
  thumbnail_height: section.settings.thumbnail_height,
  thumbnail_arrows: section.settings.thumbnail_arrows,
  mobile_layout: section.settings.mobile_layout,
  video_looping: section.settings.enable_video_looping,
  video_style: section.settings.product_video_style,
  section_class: sb_section_class,
  context: 'main-product',
-%}

{% style %}
  .product-section--sealed-pokemon .product-single__meta {
    border-radius: 18px;
  }

  .product-section--sealed-pokemon .product-block--sales-point .icon-and-text {
    width: 100%;
    justify-content: flex-start;
  }

  .product-section--sealed-pokemon .product-block--sales-point .icon-and-text.inventory--low {
    background: rgba(244, 175, 41, 0.12);
    border-color: rgba(244, 175, 41, 0.4);
  }

  .product-section--sealed-pokemon .product-shipping-note {
    margin: 4px 0 0;
    color: #5a6372;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .product-section--sealed-pokemon .product-shipping-note strong {
    color: #0b1220;
    font-weight: 700;
  }

  .product-section--sealed-pokemon .product-shipping-note__link {
    color: #0b1220;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .product-section--sealed-pokemon .product-shipping-progress {
    margin-top: 5px;
  }

  .product-section--sealed-pokemon .product-shipping-progress__track {
    width: 100%;
    height: 7px;
    border-radius: 999px;
    overflow: hidden;
    background: #e6eaf2;
  }

  .product-section--sealed-pokemon .product-shipping-progress__fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #d4af37 0%, #e8c861 100%);
    transition: width 0.25s ease;
  }

  .product-section--sealed-pokemon .product-shipping-progress__label {
    margin-top: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #5a6372;
  }

  .product-section--sealed-pokemon .sb-sealed-cta-proof {
    margin: 4px 0 0;
    display: grid;
    gap: 4px;
  }

  .product-section--sealed-pokemon .sb-sealed-cta-proof span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 600;
    color: #364152;
  }

  .product-section--sealed-pokemon .sb-sealed-cta-proof span::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4af37;
    flex: 0 0 6px;
  }

  .product-section--sealed-pokemon .product-single__form .payment-buttons {
    gap: 10px;
  }

  .product-section--sealed-pokemon .product-block--sales-point .sales-points {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .product-section--sealed-pokemon .product-block--sales-point .icon-and-text {
    border: 1px solid #dde3ef;
    border-radius: 999px;
    background: #f8f5ee;
    padding: 8px 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .product-section--sealed-pokemon .product-block--sales-point .icon {
    width: 12px;
    height: 12px;
    opacity: 0.78;
  }

  .product-section--sealed-pokemon.sb-sealed-pdp-scope .product-single__form .payment-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .product-section--sealed-pokemon.sb-sealed-pdp-scope .product-single__form .payment-buttons > .shopify-payment-button {
    margin-top: 0;
  }

  .product-section--sealed-pokemon .shopify-payment-button__more-options {
    color: #5a6372;
    text-underline-offset: 3px;
  }

  .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge {
    margin: 0;
    line-height: 1.2;
  }

  .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge .jdgm-prev-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #5a6372;
  }

  .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge .jdgm-prev-badge__stars {
    display: none;
  }

  .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge .jdgm-prev-badge__text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #5a6372;
  }

  .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge .jdgm-prev-badge::before {
    content: 'Reviews';
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0b1220;
    background: rgba(212, 175, 55, 0.16);
    border: 1px solid rgba(212, 175, 55, 0.32);
    border-radius: 999px;
    padding: 1px 7px;
    line-height: 1.4;
  }

  .product-section--sealed-pokemon .product-description {
    text-align: left;
  }

  .product-section--sealed-pokemon .product-description__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
  }

  .product-section--sealed-pokemon .product-description__toggle::after {
    content: '>';
    font-weight: 700;
  }

  .product-section--sealed-pokemon .collapsibles-wrapper {
    margin-top: 12px;
  }

  .product-section--sealed-pokemon .product-block--tab {
    margin-bottom: 4px;
  }

  .product-section--sealed-pokemon .product-block--tab:last-child {
    margin-bottom: 0;
  }

  .product-section--sealed-pokemon .collapsible-trigger-btn {
    letter-spacing: 0.18em;
    font-size: 0.75rem;
  }

  /* Make each accordion its own card */
  .product-section--sealed-pokemon .product-block--tab .collapsibles-wrapper--border-bottom {
    border: 1px solid #e6eaf2;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  /* Button becomes borderless inside the card */
  .product-section--sealed-pokemon .product-block--tab .collapsible-trigger-btn--borders {
    border: 0;
    border-radius: 0;
    padding: 12px 14px;
  }

  /* Divider between header and content when open */
  .product-section--sealed-pokemon .product-block--tab .collapsible-content {
    border-top: 1px solid #e6eaf2;
  }

  /* Sealed Pokemon: disable global negative margin stacking */
.product-section--sealed-pokemon .product-block--tab + .product-block--tab,
.product-section--sealed-pokemon .product-block--sales-point + .product-block--sales-point,
.product-section--sealed-pokemon .product-block--header + .product-block--price {
  margin-top: 0;
}

/* Then control spacing explicitly (tight but not overlapping) */
.product-section--sealed-pokemon .product-block--tab {
  margin-bottom: 4px; /* 0–6px depending on preference */
}

.product-section--sealed-pokemon .product-block--sales-point {
  margin-bottom: 6px;
}

.product-section--sealed-pokemon .product-block--header {
  margin-bottom: 10px;
}

.product-section--sealed-pokemon .product-block--price {
  margin-bottom: 10px;
}

  /* Keep your inner padding */
  .product-section--sealed-pokemon .collapsible-trigger-btn--borders + .collapsible-content .collapsible-content__inner {
    padding: 12px 14px;
  }

  .product-section--sealed-pokemon .collapsible-trigger-btn--borders .collapsible-trigger__icon {
    right: 14px;
  }

  .product-section--sealed-pokemon .collapsible-trigger-btn--borders + .collapsible-content .collapsible-content__inner {
    padding: 12px 14px;
  }

  @media (min-width: 769px) {
    .product-section--sealed-pokemon .product-single__meta {
      padding: 28px 30px;
      box-shadow: 0 14px 30px rgba(11, 18, 32, 0.08);
    }

    .product-section--sealed-pokemon .product-single__title {
      font-size: 1.85rem;
      line-height: 1.25;
    }

    .product-section--sealed-pokemon .product__price {
      font-size: 1.85rem;
    }

    .product-section--sealed-pokemon .product-block {
      margin-bottom: 16px;
    }

    .product-section--sealed-pokemon .product-trust-line {
      font-size: 0.92rem;
    }

    .product-section--sealed-pokemon .product-block--sales-point .icon-and-text {
      font-size: 0.9rem;
    }

    .product-section--sealed-pokemon .product-single__form .add-to-cart {
      min-height: 54px;
      font-size: 0.96rem;
    }

    .product-section--sealed-pokemon .shopify-payment-button__button {
      min-height: 50px;
    }

    .product-section--sealed-pokemon .shopify-payment-button__more-options {
      font-size: 0.9rem;
    }

    .product-section--sealed-pokemon .product-shipping-note {
      font-size: 0.9rem;
      text-align: left;
    }

    .product-section--sealed-pokemon .product-block hr {
      margin: 14px 0;
    }
  }

  @media (max-width: 768px) {
    .product-section--sealed-pokemon .breadcrumb {
      display: none;
    }

    .template-product .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product__main-photos {
      margin-bottom: 14px;
      margin-left: -12px;
      margin-right: -12px;
    }

    .template-product .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-image-main > .image-wrap {
      padding-bottom: min(88vw, 52vh) !important;
      background: #fff;
    }

    .template-product .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-image-main > .image-wrap img {
      object-fit: contain;
    }

    .product-section--sealed-pokemon .product-single__meta {
      padding: 20px 18px;
      box-shadow: 0 10px 24px rgba(11, 18, 32, 0.08);
    }

    .product-section--sealed-pokemon .product-single__title {
      font-size: 1.55rem;
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    .product-section--sealed-pokemon .product-block {
      margin-bottom: 12px;
    }

    .product-section--sealed-pokemon .product-block--price {
      margin-bottom: 10px;
    }

    .product-section--sealed-pokemon .product__price {
      font-size: 1.6rem;
    }

    .product-section--sealed-pokemon .product-trust-line {
      margin-bottom: 10px;
      padding: 6px 10px;
      font-size: 0.85rem;
      line-height: 1.35;
    }

    .product-section--sealed-pokemon .product-block--sales-point {
      margin-top: 2px;
      margin-bottom: 6px;
    }

    .product-section--sealed-pokemon .product-block--sales-point .icon-and-text {
      padding: 7px 12px;
      font-size: 0.8rem;
    }

    .product-section--sealed-pokemon .product-block--sales-point .icon {
      width: 11px;
      height: 11px;
    }

    .product-section--sealed-pokemon .product-shipping-note {
      margin: 2px 0 6px;
      font-size: 0.82rem;
      line-height: 1.35;
      text-align: center;
    }

    .product-section--sealed-pokemon .product-shipping-progress__label {
      font-size: 0.7rem;
    }

    .product-section--sealed-pokemon .sb-sealed-cta-proof {
      margin-top: 1px;
      gap: 3px;
    }

    .product-section--sealed-pokemon .sb-sealed-cta-proof span {
      font-size: 0.78rem;
      line-height: 1.25;
    }

    .product-section--sealed-pokemon .jdgm-widget.jdgm-preview-badge {
      margin: 2px 0 0;
    }

    .product-section--sealed-pokemon .product-block--sales-point[data-sales-point-index="1"],
    .product-section--sealed-pokemon .product-block--sales-point[data-sales-point-index="2"],
    .product-section--sealed-pokemon .product-block--sales-point[data-sales-point-index="3"] {
      display: none;
    }

    .product-section--sealed-pokemon .product-single__form .add-to-cart {
      min-height: 52px;
      font-size: 0.95rem;
    }

    .product-section--sealed-pokemon .shopify-payment-button__button {
      min-height: 48px;
    }

    .product-section--sealed-pokemon .shopify-payment-button__more-options {
      margin: 6px 0;
      font-size: 0.82rem;
      opacity: 0.88;
    }

    .product-section--sealed-pokemon .product-block hr {
      margin: 10px 0;
    }

    .product-section--sealed-pokemon .social-sharing {
      display: none;
    }

    .product-section--sealed-pokemon .product-description__toggle {
      margin-top: 6px;
      font-size: 0.88rem;
    }

    .product-section--sealed-pokemon .product-description--collapsed .rte {
      -webkit-line-clamp: 12;
    }

    .product-section--sealed-pokemon .product-description .rte h1,
    .product-section--sealed-pokemon .product-description .rte h2,
    .product-section--sealed-pokemon .product-description .rte h3,
    .product-section--sealed-pokemon .product-description .rte h4 {
      margin-top: 10px;
      margin-bottom: 6px;
    }

    .product-section--sealed-pokemon .product-description .rte ul {
      margin-left: 22px;
    }

    .product-section--sealed-pokemon .product-description .rte li {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      line-height: 1.45;
      margin-bottom: 6px;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description__toggle {
      font-size: 0;
      gap: 0;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description__toggle::after {
      content: '';
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description__toggle::before {
      content: 'Full description >';
      font-size: 0.88rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: inherit;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description__toggle[aria-expanded="true"]::before {
      content: 'Show less';
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-quick-facts__heading {
      display: block;
      margin: 10px 0 6px;
      font-size: 0;
      line-height: 0;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-quick-facts__heading::before {
      content: 'Quick facts';
      display: block;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #0b1220;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-quick-facts__list {
      margin: 0 0 10px;
      padding-left: 18px;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-quick-facts__list li {
      margin-bottom: 4px;
      line-height: 1.35;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-quick-facts__list li:last-child {
      margin-bottom: 0;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description.sb-quick-facts--overflow:not(.product-description--expanded) .sb-quick-facts__list li:nth-child(n+5) {
      display: none;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .product-description.sb-quick-facts--overflow .product-description__toggle[hidden] {
      display: inline-flex !important;
    }

    body.template-product #shopify-section-{{ section.id }} .product-section--sealed-pokemon.sb-product-card--sealed-pokemon .sb-sealed-accordion-note {
      margin: 8px 0 10px;
      font-size: 0.875rem;
      line-height: 1.4;
      font-weight: 600;
      color: #5a6372;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group {
      margin-top: 16px;
      margin-bottom: 12px;
      border: 1px solid #e6eaf2;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 10px 22px rgba(11, 18, 32, 0.06);
      overflow: hidden;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .product-block--tab {
      margin: 0;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .product-block--tab + .product-block--tab {
      border-top: 0;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsibles-wrapper {
      margin-top: 0;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsibles-wrapper--border-bottom {
      border: 0;
      border-bottom: 1px solid #e6eaf2;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      margin: 0;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .product-block--tab:last-child .collapsibles-wrapper--border-bottom {
      border-bottom: 1px solid #e6eaf2;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger-btn {
      padding: 14px 48px 14px 16px;
      min-height: 48px;
      font-size: 0.82rem;
      letter-spacing: 0.2em;
      font-weight: 700;
      color: #0b1220;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger__icon {
      right: 16px;
      width: 14px;
      height: 14px;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger__icon .icon {
      width: 14px;
      height: 14px;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger__icon svg path {
      stroke: #0b1220;
      stroke-width: 2.2;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger[aria-expanded="true"],
    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-trigger.is-open {
      background: #f8f5ee;
      box-shadow: inset 3px 0 0 rgba(212, 175, 55, 0.7);
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-content {
      border-top: 1px solid #e6eaf2;
      background: #fff;
    }

    .product-section--sealed-pokemon .sb-sealed-accordion-group .collapsible-content__inner {
      padding: 12px 16px 16px;
    }

    .product-recommendations--sealed {
      position: relative;
      margin-top: 20px;
      padding-top: 14px;
      padding-bottom: 0;
    }

    .product-recommendations--sealed::after {
      content: '';
      display: block;
      height: calc(36px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid rgba(11, 18, 32, 0.12);
    }

    .product-recommendations--sealed .section-header__title {
      font-size: 1.3rem;
    }

    .product-recommendations--sealed .section-header {
      margin-bottom: 12px;
    }

    .product-recommendations--sealed .sb-card--pad-40 {
      padding: 22px;
    }

    .product-recommendations--sealed .grid-product__content {
      border-radius: 16px;
      padding: 14px 12px;
    }

    .product-recommendations--sealed .grid-product__title {
      font-size: 0.9rem;
      line-height: 1.2;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      min-height: 2.4em;
      word-break: break-word;
    }

    .product-recommendations--sealed .grid-product__price {
      font-size: 0.92rem;
    }

    .product-recommendations--sealed .jdgm-widget.jdgm-preview-badge {
      display: none;
    }
  }

  {%- if template == 'product.product-acrylics' -%}
    {%- render 'acrylic-pdp-overrides', section_id: section.id -%}
  {%- endif -%}

  @media (min-width: 750px) {
    body.sb-pdp-polished .sb-sealed-pdp-scope .product-block--header,
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product-block--header {
      margin-bottom: 12px;
    }

    body.sb-pdp-polished .sb-sealed-pdp-scope .product-single__title,
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product-single__title {
      margin-bottom: 0;
    }

    body.sb-pdp-polished .sb-sealed-pdp-scope .product-block--price,
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product-block--price {
      margin-bottom: 12px;
    }

    body.sb-pdp-polished .sb-sealed-pdp-scope .product__price,
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product__price {
      margin-bottom: 0;
    }

    body.sb-pdp-polished .sb-sealed-pdp-scope .product-block:has(.product-single__form),
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product-block:has(.product-single__form) {
      margin-bottom: 8px;
    }

    body.sb-pdp-polished .sb-sealed-pdp-scope .product-block:has(.product-single__form) > .product-block,
    body.sb-pdp-polished .sb-acrylics-pdp-scope .product-block:has(.product-single__form) > .product-block {
      margin-bottom: 0;
