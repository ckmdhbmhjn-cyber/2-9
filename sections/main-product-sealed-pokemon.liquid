{%- if is_modal != true and template == 'product.product-sealed-pokemon' -%}
  <script>
    (function() {
      if (!document.body.classList.contains('template-product')) {
        return;
      }

      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) {
        return;
      }

      var root = section.querySelector('.product-section--sealed-pokemon.sb-product-card--sealed-pokemon');
      if (!root) {
        return;
      }

      var stickyBar = root.querySelector('[data-product-sticky-atc]');
      if (!stickyBar) {
        return;
      }

      var stickyButton = stickyBar.querySelector('[data-sticky-atc-button]');
      var stickyText = stickyBar.querySelector('[data-sticky-atc-text]');
      var stickyPrice = stickyBar.querySelector('[data-sticky-atc-price]');
      if (!stickyButton || !stickyText) {
        return;
      }

      var shippingThresholdCents = parseInt(root.getAttribute('data-free-shipping-threshold-cents'), 10);
      if (isNaN(shippingThresholdCents) || shippingThresholdCents <= 0) {
        shippingThresholdCents = 15000;
      }

      var flatShippingCents = parseInt(root.getAttribute('data-flat-shipping-cents'), 10);
      if (isNaN(flatShippingCents) || flatShippingCents < 0) {
        flatShippingCents = 699;
      }

      var storeMoneyFormat = root.getAttribute('data-store-money-format') || {{ shop.money_format | json }};

      var ctaSelectors = [
        '[data-klaviyo-bis-trigger]',
        '[data-klaviyo-bis]',
        '.klaviyo-bis-trigger',
        'button[data-variant-id][data-product-id]',
        'a[data-variant-id][data-product-id]',
        '[data-add-to-cart]',
        '.add-to-cart'
      ];

      var mobileQuery = window.matchMedia('(max-width: 749px)');
      var isMobile = function() {
        return mobileQuery.matches;
      };

      var isVisible = function(el) {
        if (!el || el.offsetParent === null) {
          return false;
        }
        var rect = el.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0;
      };

      var isAddToCart = function(el) {
        return el && (el.matches('[data-add-to-cart]') || el.classList.contains('add-to-cart'));
      };

      var isDisabled = function(el) {
        if (!el) {
          return false;
        }
        return el.hasAttribute('disabled')
          || el.getAttribute('aria-disabled') === 'true'
          || el.classList.contains('disabled');
      };

      var getCtaLabel = function(el) {
        if (!el) {
          return '';
        }
        var labelSource = el.querySelector('[data-add-to-cart-text]') || el.querySelector('.add-to-cart__text');
        var label = '';
        if (labelSource && labelSource.textContent) {
          label = labelSource.textContent;
        } else if (el.tagName === 'INPUT') {
          label = el.value || '';
        } else if (el.textContent) {
          label = el.textContent;
        }
        return label.replace(/\s+/g, ' ').trim();
      };

      var formatMoney = function(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          try {
            return window.Shopify.formatMoney(cents, storeMoneyFormat);
          } catch (error) {
            // Fallback handled below.
          }
        }
        return '$' + (cents / 100).toFixed(2);
      };

      var parseMoneyToCents = function(rawValue) {
        if (!rawValue) {
          return null;
        }
        var cleaned = rawValue.replace(/[^0-9.,]/g, '');
        if (!cleaned) {
          return null;
        }
        var normalized = cleaned;
        if (cleaned.indexOf(',') > -1 && cleaned.indexOf('.') === -1) {
          normalized = cleaned.replace(',', '.');
        } else {
          normalized = cleaned.replace(/,/g, '');
        }
        var amount = parseFloat(normalized);
        if (isNaN(amount)) {
          return null;
        }
        return Math.round(amount * 100);
      };

      var getCurrentVariantPriceCents = function() {
        var currentVariantJson = root.querySelector('[data-current-variant-json]');
        if (currentVariantJson && currentVariantJson.textContent) {
          try {
            var parsedVariant = JSON.parse(currentVariantJson.textContent);
            if (parsedVariant && typeof parsedVariant.price === 'number') {
              return parsedVariant.price;
            }
          } catch (error) {
            // Fallback handled below.
          }
        }

        var priceSource = root.querySelector('[data-product-price]') || root.querySelector('.product__price');
        if (!priceSource || !priceSource.textContent) {
          return null;
        }
        return parseMoneyToCents(priceSource.textContent);
      };

      var ensureShippingProgressUi = function(noteEl) {
        if (!noteEl || !noteEl.parentNode) {
          return null;
        }

        var parent = noteEl.parentNode;
        var progress = parent.querySelector('[data-sealed-shipping-progress]');
        if (progress) {
          return progress;
        }

        progress = document.createElement('div');
        progress.className = 'product-shipping-progress';
        progress.setAttribute('data-sealed-shipping-progress', '');

        var track = document.createElement('div');
        track.className = 'product-shipping-progress__track';
        track.setAttribute('aria-hidden', 'true');

        var fill = document.createElement('div');
        fill.className = 'product-shipping-progress__fill';
        fill.setAttribute('data-sealed-shipping-progress-fill', '');
        track.appendChild(fill);

        var label = document.createElement('p');
        label.className = 'product-shipping-progress__label';
        label.setAttribute('data-sealed-shipping-progress-label', '');

        progress.appendChild(track);
        progress.appendChild(label);
        noteEl.insertAdjacentElement('afterend', progress);

        return progress;
      };

      var updateShippingProgress = function() {
        var noteEl = root.querySelector('.product-shipping-note');
        if (!noteEl) {
          return;
        }

        var priceCents = getCurrentVariantPriceCents();
        if (priceCents === null) {
          return;
        }

        var remainingCents = Math.max(0, shippingThresholdCents - priceCents);
        var progressPercent = Math.min(100, Math.max(0, Math.round((priceCents / shippingThresholdCents) * 100)));
        var thresholdLabel = formatMoney(shippingThresholdCents);
        var flatRateLabel = formatMoney(flatShippingCents);
        var baseShippingPrefix = 'Flat ' + flatRateLabel + ' shipping today.';

        if (remainingCents > 0) {
          if (remainingCents <= 5000) {
            noteEl.innerHTML = baseShippingPrefix + ' Add <strong>' + formatMoney(remainingCents) + '</strong> for free shipping. <a class="product-shipping-note__link" href="#shopify-section-product-recommendations">Add a low-cost item</a>.';
          } else if (remainingCents <= 15000) {
            noteEl.innerHTML = baseShippingPrefix + ' You\'re <strong>' + formatMoney(remainingCents) + '</strong> away from free shipping.';
          } else {
            noteEl.innerHTML = baseShippingPrefix + ' Free shipping on orders ' + thresholdLabel + '+.';
          }
        } else {
          noteEl.innerHTML = '<strong>Free shipping unlocked.</strong> This item qualifies for free shipping.';
        }

        var progress = ensureShippingProgressUi(noteEl);
        if (!progress) {
          return;
        }

        var fillEl = progress.querySelector('[data-sealed-shipping-progress-fill]');
        if (fillEl) {
          fillEl.style.width = progressPercent + '%';
        }

        var labelEl = progress.querySelector('[data-sealed-shipping-progress-label]');
        if (labelEl) {
          if (remainingCents > 0) {
            if (remainingCents <= 15000) {
              labelEl.textContent = progressPercent + '% toward free shipping';
            } else {
              labelEl.textContent = 'Free shipping unlocks at ' + thresholdLabel + '+';
            }
          } else {
            labelEl.textContent = '100% toward free shipping';
          }
        }
      };

      var stickyVisibleClass = 'sb-sticky-atc-visible';

      var updateStickySpacer = function() {
        var isStickyVisible = stickyBar.classList.contains('product-sticky-atc--visible')
          && !stickyBar.classList.contains('product-sticky-atc--footer-hide');
        document.body.classList.toggle('has-sticky-atc', isStickyVisible);

        if (!isMobile()) {
          root.classList.remove(stickyVisibleClass);
          return;
        }

        if (isStickyVisible) {
          root.classList.add(stickyVisibleClass);
        } else {
          root.classList.remove(stickyVisibleClass);
        }
      };

      var returnLink = null;

      var updateReturnLinkStyle = function() {
        if (!returnLink) {
          returnLink = document.querySelector('.return-link');
        }
        if (!returnLink) {
          return;
        }
        if (isMobile()) {
          returnLink.classList.add('btn--secondary');
          returnLink.style.backgroundColor = '#fff';
          returnLink.style.borderColor = 'rgba(11, 18, 32, 0.2)';
          returnLink.style.boxShadow = 'none';
          returnLink.style.minHeight = '44px';
          returnLink.style.padding = '10px 16px';
        } else {
          returnLink.classList.remove('btn--secondary');
          returnLink.style.backgroundColor = '';
          returnLink.style.borderColor = '';
          returnLink.style.boxShadow = '';
          returnLink.style.minHeight = '';
          returnLink.style.padding = '';
        }
      };

      var normalizeText = function(value) {
        return value ? value.replace(/\s+/g, ' ').trim().toLowerCase() : '';
      };

      var findHeadingByText = function(container, candidates) {
        if (!container) {
          return null;
        }
        var elements = container.querySelectorAll('h1, h2, h3, h4, h5, h6, p, strong');
        for (var i = 0; i < elements.length; i++) {
          var text = normalizeText(elements[i].textContent);
          for (var j = 0; j < candidates.length; j++) {
            if (text === candidates[j]) {
              return elements[i];
            }
          }
        }
        return null;
      };

      var getListAfter = function(heading) {
        if (!heading) {
          return null;
        }
        var start = heading;
        if (heading.tagName === 'STRONG' && heading.parentElement) {
          start = heading.parentElement;
        }
        var sibling = start.nextElementSibling;
        while (sibling) {
          if (sibling.tagName === 'UL' || sibling.tagName === 'OL') {
            return sibling;
          }
          sibling = sibling.nextElementSibling;
        }
        return null;
      };

      var applyQuickFacts = function() {
        var description = root.querySelector('.product-description .rte');
        if (!description) {
          return null;
        }
        var heading = findHeadingByText(description, ["what's inside", 'whats inside', 'what’s inside']);
        if (!heading) {
          return null;
        }
        heading.classList.add('sb-quick-facts__heading');
        if (heading.tagName === 'STRONG' && heading.parentElement) {
          heading.parentElement.classList.add('sb-quick-facts__heading');
        }
        var list = getListAfter(heading);
        if (list) {
          list.classList.add('sb-quick-facts__list');
          var wrapper = root.querySelector('.product-description');
          if (wrapper) {
            var itemCount = list.querySelectorAll('li').length;
            if (itemCount > 4) {
              wrapper.classList.add('sb-quick-facts--overflow');
            } else {
              wrapper.classList.remove('sb-quick-facts--overflow');
            }
          }
        }
        return list;
      };

      var updateAccordionNote = function() {
        var noteClass = 'sb-sealed-accordion-note';
        var group = root.querySelector('.sb-sealed-accordion-group');
        var existing = root.querySelector('.' + noteClass);
        if (!isMobile()) {
          if (existing) {
            existing.parentNode.removeChild(existing);
          }
          return;
        }
        if (group && !existing) {
          var note = document.createElement('p');
          note.className = noteClass;
          note.textContent = 'Authenticity guaranteed. Packed for collectors.';
          group.parentNode.insertBefore(note, group);
        }
      };

      var recentlyViewedObserver = null;

      var getRecentlyViewedElements = function() {
        var section = document.querySelector('[data-section-type="recently-viewed"]');
        if (!section) {
          return null;
        }
        return {
          section: section,
          hr: section.querySelector('.hr--large'),
          indexSection: section.querySelector('.index-section'),
          gridWrapper: section.querySelector('.grid-overflow-wrapper'),
          grid: section.querySelector('[id^="RecentlyViewed-"]')
        };
      };

      var resetRecentlyViewedSpacing = function(elements) {
        if (!elements) {
          return;
        }
        if (elements.hr) {
          elements.hr.style.margin = '';
        }
        if (elements.indexSection) {
          elements.indexSection.style.paddingTop = '';
          elements.indexSection.style.paddingBottom = '';
        }
        if (elements.gridWrapper) {
          elements.gridWrapper.style.paddingBottom = '';
          elements.gridWrapper.style.marginBottom = '';
        }
      };

      var updateRecentlyViewedSpacing = function() {
        var elements = getRecentlyViewedElements();
        if (!elements) {
          return;
        }
        if (!isMobile()) {
          resetRecentlyViewedSpacing(elements);
          return;
        }
        var itemCount = 0;
        if (elements.grid) {
          itemCount = elements.grid.querySelectorAll('.grid__item').length;
          if (!itemCount) {
            itemCount = elements.grid.children.length;
          }
        }
        if (itemCount > 1) {
          resetRecentlyViewedSpacing(elements);
          return;
        }
        if (elements.hr) {
          elements.hr.style.margin = '12px 0';
        }
        if (elements.indexSection) {
          elements.indexSection.style.paddingTop = itemCount === 0 ? '6px' : '10px';
          elements.indexSection.style.paddingBottom = itemCount === 0 ? '8px' : '12px';
        }
        if (elements.gridWrapper) {
          elements.gridWrapper.style.paddingBottom = '0';
          elements.gridWrapper.style.marginBottom = '0';
        }
      };

      var observeRecentlyViewed = function() {
        var elements = getRecentlyViewedElements();
        if (!elements || !elements.grid) {
          return;
        }
        if (recentlyViewedObserver) {
          recentlyViewedObserver.disconnect();
        }
        if ('MutationObserver' in window) {
          recentlyViewedObserver = new MutationObserver(updateRecentlyViewedSpacing);
          recentlyViewedObserver.observe(elements.grid, { childList: true });
        }
        updateRecentlyViewedSpacing();
      };

      var applyDescriptionEnhancements = function() {
        if (!isMobile()) {
          var wrapper = root.querySelector('.product-description');
          if (wrapper) {
            wrapper.classList.remove('sb-quick-facts--overflow');
          }
          updateAccordionNote();
          updateRecentlyViewedSpacing();
          return;
        }
        applyQuickFacts();
        updateAccordionNote();
        updateRecentlyViewedSpacing();
      };

      var getPrimaryCta = function() {
        var form = root.querySelector('.product-single__form');
        if (!form) {
          return null;
        }
        for (var i = 0; i < ctaSelectors.length; i++) {
          var el = form.querySelector(ctaSelectors[i]);
          if (el && isVisible(el)) {
            return el;
          }
        }
        return null;
      };

      var syncStickyCtaState = function() {
        if (!isMobile()) {
          return;
        }
        var primary = getPrimaryCta();
        if (!primary) {
          return;
        }
        var label = getCtaLabel(primary);
        if (label) {
          stickyText.textContent = label;
        }

        if (isDisabled(primary)) {
          stickyButton.setAttribute('disabled', 'disabled');
        } else {
          stickyButton.removeAttribute('disabled');
        }
      };

      var getPriceSource = function() {
        return root.querySelector('[data-product-price]') || root.querySelector('.product__price');
      };

      var syncStickyPrice = function() {
        if (!isMobile() || !stickyPrice) {
          return;
        }
        var priceSource = getPriceSource();
        if (!priceSource) {
          return;
        }
        var nextPrice = priceSource.textContent ? priceSource.textContent.replace(/\s+/g, ' ').trim() : '';
        if (nextPrice && stickyPrice.textContent !== nextPrice) {
          stickyPrice.textContent = nextPrice;
        }
      };

      var syncHandle = null;
      var scheduleSync = function() {
        if (syncHandle) {
          return;
        }
        syncHandle = requestAnimationFrame(function() {
          syncHandle = null;
          syncStickyCtaState();
          syncStickyPrice();
          updateShippingProgress();
          observePrimaryCta();
          updateStickySpacer();
          updateStickyBottomBoundary();
        });
      };

      stickyButton.addEventListener('click', function(event) {
        var primary = getPrimaryCta();
        if (!primary || isAddToCart(primary)) {
          return;
        }
        event.preventDefault();
        event.stopImmediatePropagation();
        primary.click();
      }, true);

      var bottomBoundaryFrame = null;
      var updateStickyBottomBoundary = function() {
        var doc = document.documentElement;
        var scrollTop = window.pageYOffset || doc.scrollTop || 0;
        var viewportBottom = scrollTop + window.innerHeight;
        var footerBuffer = isMobile() ? 220 : 180;
        var nearBottom = viewportBottom >= (doc.scrollHeight - footerBuffer);

        stickyBar.classList.toggle('product-sticky-atc--footer-hide', nearBottom);
        updateStickySpacer();
      };

      var scheduleBottomBoundaryCheck = function() {
        if (bottomBoundaryFrame) {
          return;
        }
        bottomBoundaryFrame = requestAnimationFrame(function() {
          bottomBoundaryFrame = null;
          updateStickyBottomBoundary();
        });
      };

      window.addEventListener('scroll', scheduleBottomBoundaryCheck);
      window.addEventListener('resize', scheduleBottomBoundaryCheck);

      var bisObserver = null;
      var observePrimaryCta = function() {
        if (!('IntersectionObserver' in window)) {
          return;
        }
        var primary = getPrimaryCta();
        if (!primary || isAddToCart(primary)) {
          if (bisObserver) {
            bisObserver.disconnect();
          }
          return;
        }
        if (bisObserver) {
          bisObserver.disconnect();
        }
        bisObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!isMobile()) {
              return;
            }
            if (entry.isIntersecting) {
              stickyBar.classList.remove('product-sticky-atc--visible');
            } else {
              stickyBar.classList.add('product-sticky-atc--visible');
            }
            updateStickySpacer();
          });
        }, { threshold: 0 });
        bisObserver.observe(primary);
      };

      var formEl = root.querySelector('.product-single__form');
      if (formEl && 'MutationObserver' in window) {
        var mutationObserver = new MutationObserver(function() {
          scheduleSync();
        });
        mutationObserver.observe(formEl, { childList: true, subtree: true, attributes: true, characterData: true });
      }

      var blocksContainer = root.querySelector('[data-product-blocks]');
      if (blocksContainer && 'MutationObserver' in window) {
        var blocksObserver = new MutationObserver(function() {
          scheduleSync();
        });
        blocksObserver.observe(blocksContainer, { childList: true, subtree: true, attributes: true, characterData: true });
      }

      syncStickyCtaState();
      syncStickyPrice();
      updateShippingProgress();
      observePrimaryCta();
      updateStickySpacer();
      updateStickyBottomBoundary();
      applyDescriptionEnhancements();
      observeRecentlyViewed();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          updateReturnLinkStyle();
          requestAnimationFrame(function() {
            updateShippingProgress();
            updateStickyBottomBoundary();
            applyDescriptionEnhancements();
            observeRecentlyViewed();
          });
        });
      } else {
        updateReturnLinkStyle();
        requestAnimationFrame(function() {
          updateShippingProgress();
          updateStickyBottomBoundary();
          applyDescriptionEnhancements();
          observeRecentlyViewed();
        });
      }

      if (mobileQuery.addEventListener) {
        mobileQuery.addEventListener('change', function() {
          observePrimaryCta();
          updateStickySpacer();
          updateReturnLinkStyle();
          requestAnimationFrame(function() {
            updateShippingProgress();
            updateStickyBottomBoundary();
            applyDescriptionEnhancements();
            observeRecentlyViewed();
          });
        });
      } else if (mobileQuery.addListener) {
        mobileQuery.addListener(function() {
          observePrimaryCta();
          updateStickySpacer();
          updateReturnLinkStyle();
          requestAnimationFrame(function() {
            updateShippingProgress();
            updateStickyBottomBoundary();
            applyDescriptionEnhancements();
            observeRecentlyViewed();
          });
        });
      }
    })();
  </script>
{%- endif -%}

