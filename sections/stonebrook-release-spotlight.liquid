{%- liquid
  assign drop_collection = section.settings.drop_collection
  assign product_primary = section.settings.featured_product
  assign product_secondary = section.settings.featured_product_secondary
  assign has_content = false

  if drop_collection != blank or product_primary != blank or product_secondary != blank
    assign has_content = true
  endif

  assign tile_1 = blank
  assign tile_2 = blank

  if product_primary != blank
    assign tile_1 = product_primary
  endif

  if product_secondary != blank
    if tile_1 == blank
      assign tile_1 = product_secondary
    elsif product_secondary.handle != tile_1.handle
      assign tile_2 = product_secondary
    endif
  endif

  if drop_collection != blank
    for drop_product in drop_collection.products
      if tile_1 != blank and tile_2 != blank
        break
      endif

      if tile_1 == blank
        if drop_product.handle != tile_2.handle
          assign tile_1 = drop_product
        endif
      elsif tile_2 == blank
        if drop_product.handle != tile_1.handle
          assign tile_2 = drop_product
        endif
      endif
    endfor
  endif

  assign tile_count = 0
  if tile_1 != blank
    assign tile_count = tile_count | plus: 1
  endif
  if tile_2 != blank
    assign tile_count = tile_count | plus: 1
  endif

  assign cta_link = ''
  if drop_collection != blank
    assign cta_link = drop_collection.url
  elsif product_primary != blank
    assign cta_link = product_primary.url
  elsif product_secondary != blank
    assign cta_link = product_secondary.url
  endif

  assign show_meta = false
  if section.settings.label_text != blank or section.settings.status_text != blank
    assign show_meta = true
  endif

  assign show_section_render = false
  if section.settings.show_section
    if tile_count > 0
      assign show_section_render = true
    elsif has_content and request.design_mode
      assign show_section_render = true
    endif
  endif
-%}
{%- if show_section_render -%}
  <section class="sb-release-spotlight" data-section-id="{{ section.id }}">
    {% style %}
      #shopify-section-{{ section.id }} .sb-release-spotlight {
        padding: clamp(16px, 2.4vw, 28px) 0;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight .page-width {
        max-width: 1100px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__card {
        background: var(--sb-card);
        border: 1px solid var(--sb-line);
        border-radius: 24px;
        box-shadow: var(--sb-shadow-soft);
        padding: 24px;
        color: var(--sb-ink);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__layout {
        display: grid;
        gap: 16px;
        align-items: center;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__copy,
      #shopify-section-{{ section.id }} .sb-release-spotlight__products-area,
      #shopify-section-{{ section.id }} .sb-release-spotlight__product-info,
      #shopify-section-{{ section.id }} .sb-release-spotlight__product-card {
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__label {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(212, 175, 55, 0.16);
        border: 1px solid rgba(212, 175, 55, 0.35);
        color: #0b1220;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 600;
        white-space: nowrap;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__status {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.06);
        border: 1px solid rgba(15, 23, 42, 0.1);
        color: rgba(15, 23, 42, 0.82);
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__label,
      #shopify-section-{{ section.id }} .sb-release-spotlight__status {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__title {
        margin: 0 0 10px;
        font-size: clamp(28px, 5vw, 32px);
        line-height: 1.15;
        color: var(--sb-ink);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__text {
        margin: 0 0 12px;
        font-size: 1rem;
        line-height: 1.6;
        color: #475569;
        max-width: 52ch;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__secondary-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--sb-ink);
        text-decoration: none;
        padding-bottom: 2px;
        border-bottom: 1px solid rgba(11, 18, 32, 0.3);
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__secondary-link:hover {
        color: var(--sb-ink);
        border-color: var(--sb-gold);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__products-area {
        display: grid;
        gap: 16px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__editor-note {
        margin: 0;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px dashed rgba(148, 163, 184, 0.6);
        background: rgba(248, 250, 252, 0.9);
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__products {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 12px;
        padding: 16px;
        border-radius: 18px;
        border: 1px solid rgba(11, 18, 32, 0.08);
        background: rgba(248, 250, 252, 0.9);
        align-items: center;
        text-decoration: none;
        color: inherit;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-card:focus-visible {
        outline: 2px solid var(--sb-gold);
        outline-offset: 3px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-media {
        width: 96px;
        height: 96px;
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid rgba(11, 18, 32, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-image--placeholder {
        width: 100%;
        height: 100%;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-info {
        display: grid;
        gap: 10px;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__product-title {
        color: var(--sb-ink);
        font-weight: 600;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        min-height: calc(1.35em * 2);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__price {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        align-items: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--sb-ink);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__price-sale {
        color: var(--color-sale-price);
        font-weight: 700;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__price-compare {
        text-decoration: line-through;
        opacity: 0.6;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__price-regular {
        font-weight: 700;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        width: 100%;
        padding: 0 16px;
        border-radius: 12px;
        background: var(--sb-gold);
        border: 1px solid var(--sb-gold);
        color: var(--sb-ink);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        box-shadow: 0 10px 20px rgba(11, 18, 32, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.55);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: background 150ms ease, border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__cta:hover,
      #shopify-section-{{ section.id }} .sb-release-spotlight__cta:focus {
        background: var(--sb-gold-hover);
        border-color: var(--sb-gold-hover);
        box-shadow: 0 12px 24px rgba(11, 18, 32, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.6);
        transform: translateY(-1px);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__cta:active {
        background: var(--sb-gold-active);
        border-color: var(--sb-gold-active);
        transform: translateY(0);
      }

      #shopify-section-{{ section.id }} .sb-release-spotlight__cta:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px var(--sb-gold-focus), 0 10px 20px rgba(11, 18, 32, 0.12);
      }

      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .sb-release-spotlight__meta {
          max-width: 100%;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__label,
        #shopify-section-{{ section.id }} .sb-release-spotlight__status {
          max-width: 100%;
          flex: 0 1 auto;
        }
      }

      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .sb-release-spotlight__card {
          padding: 40px 32px;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__layout {
          grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
          gap: 18px;
          align-items: start;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__title {
          font-size: clamp(34px, 3.2vw, 40px);
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__text {
          font-size: 1.05rem;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__products {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
          width: 100%;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__products--single {
          grid-template-columns: minmax(0, 1fr);
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__products--pair .sb-release-spotlight__product-card {
          grid-template-columns: 1fr;
          align-items: start;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__products--pair .sb-release-spotlight__product-media {
          justify-self: start;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__product-media {
          width: 132px;
          height: 132px;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__product-card {
          padding: 18px;
        }

        #shopify-section-{{ section.id }} .sb-release-spotlight__cta {
          height: 48px;
          justify-self: stretch;
        }
      }
    {% endstyle %}
    <div class="page-width">
      <div class="sb-release-spotlight__card">
        <div class="sb-release-spotlight__layout">
          <div class="sb-release-spotlight__copy">
            {%- if show_meta -%}
              <div class="sb-release-spotlight__meta">
                {%- if section.settings.label_text != blank -%}
                  <span class="sb-release-spotlight__label">{{ section.settings.label_text }}</span>
                {%- endif -%}
                {%- if section.settings.status_text != blank -%}
                  <span class="sb-release-spotlight__status">{{ section.settings.status_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="sb-release-spotlight__title">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.supporting_text != blank -%}
              <p class="sb-release-spotlight__text">{{ section.settings.supporting_text | newline_to_br }}</p>
            {%- endif -%}
            {%- if section.settings.secondary_link != blank and section.settings.secondary_link_label != blank -%}
              <a class="sb-release-spotlight__secondary-link" href="{{ section.settings.secondary_link }}">
                {{ section.settings.secondary_link_label }}
              </a>
            {%- endif -%}
          </div>

          <div class="sb-release-spotlight__products-area">
            {%- if tile_count > 0 -%}
              <div class="sb-release-spotlight__products{% if tile_count == 1 %} sb-release-spotlight__products--single{% elsif tile_count > 1 %} sb-release-spotlight__products--pair{% endif %}">
                {%- assign tile = tile_1 -%}
                {%- if tile != blank -%}
                  {%- liquid
                    assign tile_variant = tile.selected_or_first_available_variant
                    assign tile_price = tile_variant.price
                    assign tile_compare_at = tile_variant.compare_at_price
                    assign tile_on_sale = false
                    if tile_compare_at > tile_price
                      assign tile_on_sale = true
                    endif
                    assign tile_image = tile.featured_media.preview_image | default: tile.featured_image
                  -%}
                  <a class="sb-release-spotlight__product-card" href="{{ tile.url }}">
                    <div class="sb-release-spotlight__product-media">
                      {%- if tile_image != blank -%}
                        {%- render 'image-element',
                          img: tile_image,
                          widths: '200, 240, 320, 400, 480',
                          sizes: '(min-width: 750px) 132px, 96px',
                          classes: 'sb-release-spotlight__product-image',
                          alt: tile_image.alt | default: tile.title,
                          loading: 'lazy'
                        -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'sb-release-spotlight__product-image sb-release-spotlight__product-image--placeholder' }}
                      {%- endif -%}
                    </div>
                    <div class="sb-release-spotlight__product-info">
                      <span class="sb-release-spotlight__product-title">{{ tile.title }}</span>
                      <div class="sb-release-spotlight__price">
                        {%- if tile_on_sale -%}
                          <span class="sb-release-spotlight__price-sale">{{ tile_price | money }}</span>
                          <span class="sb-release-spotlight__price-compare">{{ tile_compare_at | money }}</span>
                        {%- else -%}
                          <span class="sb-release-spotlight__price-regular">{{ tile_price | money }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
                {%- assign tile = tile_2 -%}
                {%- if tile != blank -%}
                  {%- liquid
                    assign tile_variant = tile.selected_or_first_available_variant
                    assign tile_price = tile_variant.price
                    assign tile_compare_at = tile_variant.compare_at_price
                    assign tile_on_sale = false
                    if tile_compare_at > tile_price
                      assign tile_on_sale = true
                    endif
                    assign tile_image = tile.featured_media.preview_image | default: tile.featured_image
                  -%}
                  <a class="sb-release-spotlight__product-card" href="{{ tile.url }}">
                    <div class="sb-release-spotlight__product-media">
                      {%- if tile_image != blank -%}
                        {%- render 'image-element',
                          img: tile_image,
                          widths: '200, 240, 320, 400, 480',
                          sizes: '(min-width: 750px) 132px, 96px',
                          classes: 'sb-release-spotlight__product-image',
                          alt: tile_image.alt | default: tile.title,
                          loading: 'lazy'
                        -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'sb-release-spotlight__product-image sb-release-spotlight__product-image--placeholder' }}
                      {%- endif -%}
                    </div>
                    <div class="sb-release-spotlight__product-info">
                      <span class="sb-release-spotlight__product-title">{{ tile.title }}</span>
                      <div class="sb-release-spotlight__price">
                        {%- if tile_on_sale -%}
                          <span class="sb-release-spotlight__price-sale">{{ tile_price | money }}</span>
                          <span class="sb-release-spotlight__price-compare">{{ tile_compare_at | money }}</span>
                        {%- else -%}
                          <span class="sb-release-spotlight__price-regular">{{ tile_price | money }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              </div>
              {%- if section.settings.cta_label != blank and cta_link != blank -%}
                <a class="btn sb-release-spotlight__cta" href="{{ cta_link }}">
                  {{ section.settings.cta_label }}
                </a>
              {%- endif -%}
            {%- elsif request.design_mode -%}
              <p class="sb-release-spotlight__editor-note">
                No products found to display. Ensure the selected products are available to the Online Store and included in the selected collection.
              </p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Stonebrook Spotlight",
  "class": "stonebrook-release-spotlight-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Small label text",
      "default": "NEW RELEASE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline text",
      "default": "Prismatic Evolutions is here"
    },
    {
      "type": "textarea",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Inventory lands tomorrow. Pre-orders are live for the first wave."
    },
    {
      "type": "collection",
      "id": "drop_collection",
      "label": "Drop collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product 1"
    },
    {
      "type": "product",
      "id": "featured_product_secondary",
      "label": "Featured product 2"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA button label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status pill text",
      "default": "Inventory arrives tomorrow"
    },
    {
      "type": "header",
      "content": "Secondary link (optional)"
    },
    {
      "type": "text",
      "id": "secondary_link_label",
      "label": "Secondary link label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "presets": [
    {
      "name": "Stonebrook Spotlight"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
